prefix=
exec_prefix=
libdir=${pcfiledir}/../../../libavfilter
includedir=${pcfiledir}/../../..

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.12.100
Requires:  libswscale >= 9.3.100,  libavformat >= 62.9.101,  libavcodec >= 62.23.103,  libswresample >= 6.2.100,  libavutil >= 60.25.100
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -lavfilter -pthread -lm -latomic -lz -lva
Cflags: -I${includedir}
