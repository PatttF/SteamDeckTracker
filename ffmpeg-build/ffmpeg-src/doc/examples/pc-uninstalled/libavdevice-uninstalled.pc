prefix=
exec_prefix=
libdir=${pcfiledir}/../../../libavdevice
includedir=${pcfiledir}/../../..

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.2.100
Requires:  libavfilter >= 11.12.100,  libswscale >= 9.3.100,  libavformat >= 62.9.101,  libavcodec >= 62.23.103,  libswresample >= 6.2.100,  libavutil >= 60.25.100
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -lavdevice -lm -latomic -ldrm -lxcb -lxcb-shm -lxcb-shape -lxcb-xfixes -lasound -lsndio -lXv -lX11 -lXext
Cflags: -I${includedir}
