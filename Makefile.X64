# Makefile.X64 — informational wrapper for X64 builds
#
# NOTE: This repository's canonical build is performed from the `projects/` directory.
# To build for X64 run (from the repo root):
#
#   make -C projects PLATFORM=X64 -j1
#
# The build will produce the `SDTracker` binary in the repository root. After a
# successful build you may run it directly:
#
#   ./SDTracker [--no-gui]
#
# This file provides a simple convenience wrapper so you can run the same
# commands from the repository root with `make build` and `make run`.

.PHONY: help build run all
all: help

help:
	@echo "Build from projects/: make -C projects PLATFORM=X64 -j1"
	@echo "Binary after build: ./SDTracker"
	@echo "Run: ./SDTracker --no-gui"

build:
	@echo "Invoking: make -C projects PLATFORM=X64 -j1"
	@$(MAKE) -C projects PLATFORM=X64 -j1

# Run the built binary (pass extra arguments via ARGS env var). Example:
#   make run ARGS="--no-gui"
run:
	@if [ -x ./SDTracker ]; then \
		./SDTracker $(ARGS); \
	else \
		echo "Binary not found: build first (see 'make help')"; exit 1; \
	fi
